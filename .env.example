# Names only. Copy to .env (gitignored) and fill in what this deployment uses.
# Credentials may also live in the OS keychain under the service "strata-aiprovider".

# Path to the TOML file holding routes and adapter settings (see aiprovider.example.toml).
AIPROVIDER_CONFIG=

# The only switch that makes a metered (pay-per-token) path reachable. Leave empty
# before launch. Must be 1 for any route that names a keys.* adapter.
AIPROVIDER_ALLOW_METERED=

# Where answers are cached (in the translator's replay shape) and calls are ledgered.
AIPROVIDER_CACHE_DIR=
AIPROVIDER_LEDGER=

# Metered API key for keys.anthropic. Deliberately not ANTHROPIC_API_KEY: that name
# would also be read by the Claude Code CLI and silently move it onto API billing.
AIPROVIDER_ANTHROPIC_API_KEY=
